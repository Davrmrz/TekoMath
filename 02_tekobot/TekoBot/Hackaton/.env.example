# Configuración de TekoBot
# Para hackathon: podés usar MySQL (XAMPP) o el modo SQLite integrado automático

# Base de Datos
DB_HOST=127.0.0.1
DB_NAME=kyhyjey_db
DB_USER=root
DB_PASS=
DB_DRIVER=mysql

# API de Inteligencia Artificial (Google Gemini)
# La clave habilita interpretación de enunciados con IA.
# Podés colocar tu GEMINI_API_KEY aquí:
GEMINI_API_KEY=

# Idioma predeterminado: jopara | es_py | es
DEFAULT_LANGUAGE=jopara
