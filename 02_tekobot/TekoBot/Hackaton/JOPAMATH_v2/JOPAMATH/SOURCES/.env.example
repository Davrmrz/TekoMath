# ==============================================================================
# MATEJOPARA LOCALIZATION TOOL - CONFIGURACIÓN DE ENTORNO (.env)
# ==============================================================================

# Servidor Local
HOST=127.0.0.1
PORT=8000
DEBUG=False

# Base de datos SQLite
DATABASE_URL=sqlite:///./matejopara.db

# Proveedor activo por defecto (mock | gemini | openai_compatible)
DEFAULT_PROVIDER=mock

# Configuración de Google Gemini
# Obtener API key en: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Configuración de Proveedor Compatible OpenAI (OpenAI, Groq, Ollama, vLLM, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Reglas de Autocorrección y Reintentos
MAX_RETRIES=2
PROMPT_VERSION=v1.0.0
